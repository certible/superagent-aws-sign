{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "node",
    "promise",
    "jest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "node": true,
    "jest": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    ".aws-sam/**",
    "index.cjs",
    "index.d.ts",
    "index.mjs"
  ],
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_data", "_formData", "_originalEnd"]
      }
    ]
  }
}
