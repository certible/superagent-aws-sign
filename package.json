{
  "name": "@certible/superagent-aws-sign",
  "version": "4.0.1",
  "description": "Superagent plugin to sign requests using AWS Signature Version 4",
  "keywords": [
    "aws",
    "request",
    "superagent"
  ],
  "bugs": {
    "url": "https://github.com/certible/superagent-aws-sign/issues"
  },
  "license": "MIT",
  "author": "Certible <oberreiter@certible.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/certible/superagent-aws-sign.git"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "index.mjs"
  ],
  "type": "module",
  "main": "index.cjs",
  "module": "index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt --write .",
    "jest:vm": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:types": "tsc --project test/types/tsconfig.json",
    "test": "pnpm run lint && pnpm run test:types && pnpm run jest:vm",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1075.0",
    "@aws-sdk/credential-providers": "^3.1075.0",
    "@types/aws4": "^1.11.6",
    "aws4": "^1.13.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "superagent": "^10.3.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.4.0"
}
